# Is file ko copy kar ke ".env" naam se save karein, phir apni key likhein.
# (start.bat chalane par yeh file khud ban jati hai, to aksar zaroorat nahi.)

# --- Option A: FREE (payment nahi chahiye) ---
# Key yahan se: https://aistudio.google.com/apikey
GEMINI_API_KEY=yahan-apni-gemini-key-likhein

# --- Option B: Claude (paid, behtar jawab) ---
# Key yahan se: https://console.anthropic.com  (billing zaroori)
# Neeche wali line se # hata kar key likhein. Dono hon to Claude use hoga.
# ANTHROPIC_API_KEY=sk-ant-...

# Website ka port (default 3000)
PORT=3000

# Har user ke liye roz ke kitne messages (image = 4 messages ke barabar). 0 = koi limit nahi.
DAILY_LIMIT=60

# Sirf wohi log account banayein jinhein aap code dein. Khali = koi bhi bana sakta hai.
SIGNUP_CODE=

# Hosting (Render, Railway wagaira) par chalayen to 1 likhein.
TRUST_PROXY=0

# Advanced (zaroorat nahi): models ke naam badalne ke liye
# MODEL_FAST=gemini-3.5-flash-lite
# MODEL_NOVA=gemini-3.6-flash
# MODEL_PRO=gemini-3.8-flash
